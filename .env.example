# Copy to .env for local runs outside docker-compose. Values below are local-only placeholders.
# Never commit a real .env file.

# HTTP port
PORT=3000
# Use a distinct metrics port per backend to avoid listener conflicts.
METRICS_PORT=9464
# Only the Docker image listens on 0.0.0.0, where the port is reachable from the container network alone.
METRICS_HOST=127.0.0.1
NODE_ENV=development

# Environment: local | staging | kvitka-uat | wisla-uat
# Prefixes all Redis channels/streams/queues (e.g. "staging:rate.tick").
# DEV_AUTH=true is refused in *-uat environments.
APP_ENV=local

# MySQL: one database per service (wallet_core for this service)
DATABASE_URL=mysql://wallet:wallet@localhost:3306/wallet_core

# Redis: events (pub/sub, streams) and BullMQ
REDIS_URL=redis://localhost:6379

# Client this deployment serves: demo | kvitka | wisla
CLIENT=demo

# Dev auth: accept "Authorization: Dev <userId>:<perm1,perm2>". Allowed only with APP_ENV local or staging.
DEV_AUTH=false

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: overrides the version shown by `health` (CI sets the git SHA)
APP_VERSION=

# Log level: fatal | error | warn | info | debug | trace | silent. JSON output; pretty with NODE_ENV=development
LOG_LEVEL=info

# JWT. HS256 secret shared with rates-service and treasury-service (same value everywhere).
# Optional locally (this local-only value is the default); required with NODE_ENV=production.
JWT_ISSUER=wallet-core
JWT_SECRET=local-only-jwt-secret-change-me-0123456789
# Access token lifetime and session (refresh token) lifetime: <number><s|m|h|d>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

#   smtp   - local: sends to Mailpit (started by ops/dev.sh up), emails are visible at http://localhost:8025
#   resend - staging, kvitka-uat, wisla-uat: sends through Resend (requires RESEND_API_KEY)
#   fake   - records emails in memory, sends nothing (tests)
EMAIL_TRANSPORT=smtp
# Sender address, the same for all environments: no-reply@wallet.shatori.com (domain verified in Resend)
EMAIL_FROM=no-reply@wallet.shatori.com
SMTP_URL=smtp://localhost:1025
# Supply the Resend secret through Dokploy rather than committing it here.
RESEND_API_KEY=

# Enable only in local or staging environments; client UAT rejects this flag.
EMAIL_PREVIEW_ENABLED=true
