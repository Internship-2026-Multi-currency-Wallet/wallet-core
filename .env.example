# Copy to .env for local runs outside docker-compose. Values below are local-only placeholders.
# Never commit a real .env file.

# HTTP port
PORT=3000
NODE_ENV=development

# Environment: local | staging | kvitka-uat | wisla-uat
# Prefixes all Redis channels/streams/queues (e.g. "staging:rate.tick").
# DEV_AUTH=true is refused in *-uat environments.
APP_ENV=local

# MySQL: one database per service (wallet_core for this service)
DATABASE_URL=mysql://wallet:wallet@localhost:3306/wallet_core

# Redis: events (pub/sub, streams) and BullMQ
REDIS_URL=redis://localhost:6379

# Client this deployment serves: demo | kvitka | wisla
CLIENT=demo

# Dev auth: accept "Authorization: Dev <userId>:<perm1,perm2>". Allowed only with APP_ENV local or staging.
DEV_AUTH=false

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: overrides the version shown by `health` (CI sets the git SHA)
APP_VERSION=

# JWT (not used yet; the real auth strategy will read these)
JWT_ISSUER=wallet-core
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
