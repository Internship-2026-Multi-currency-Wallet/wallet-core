{
  "name": "wallet-core",
  "version": "0.1.0",
  "description": "Wallet core service: users, auth, ledger, conversions, client settings",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.mjs --runInBand",
    "schema:generate": "nest build && node dist/schema-generate.js",
    "migrate": "node scripts/migrate.ts latest",
    "migrate:rollback": "node scripts/migrate.ts rollback",
    "migrate:status": "node scripts/migrate.ts status",
    "migrate:make": "node scripts/migrate.ts make",
    "infra": "sh -c 'if [ ! -x ../ops/dev.sh ]; then echo \"infra: ../ops/dev.sh not found. Clone the ops repository next to this one: git clone git@github.com:Internship-2026-Multi-currency-Wallet/ops.git ../ops\" >&2; exit 1; fi; exec ../ops/dev.sh \"$@\"' infra",
    "infra:up": "npm run infra -- up",
    "infra:down": "npm run infra -- down",
    "infra:ps": "npm run infra -- ps"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "cookie": "^1.1.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "graphql-ws": "^6.4.1",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
